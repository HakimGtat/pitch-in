# Pitch In configuration. Copy this file to .env and fill it in.
# Every value below is fake. Never commit .env.

# The address people open Pitch In at. GitHub redirects back here after sign-in.
APP_URL=http://localhost:3000

# Long random string that signs sign-in cookies (32+ characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string-0123456789

# Postgres. docker compose builds the containers' DATABASE_URL from these.
# Use letters and numbers only in the password. Changing it later needs a fresh database volume.
POSTGRES_USER=pitchin
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=pitchin
# Only used when you run the app or tests on your own machine outside Docker.
DATABASE_URL=postgres://pitchin:change-me-local-only@localhost:5432/pitchin

# The company's GitHub org and teams. Use team slugs (the last part of the team's URL).
GITHUB_ORG=example-org
# Only members of this team can sign in. Re-checked at every sign-in.
GITHUB_SIGNIN_TEAM=wishlist-users
# Optional. Members of this team get the Developer profile pre-picked at first sign-in.
# Posting work needs write access to the repo on GitHub, whatever team someone is in.
GITHUB_AI_TEAM=ai-team
# This GitHub login becomes the main admin at their first sign-in.
# After that, the role is handed over in the admin screen and this value is ignored.
MAIN_ADMIN_GITHUB_LOGIN=example-admin

# Webhook relay so GitHub can reach this machine. Create a channel at https://smee.io/new
# Keep it private: anyone with the URL can read webhook contents (not code).
SMEE_URL=https://smee.io/FakeChannel0123456

# GitHub App. Leave these blank, open /setup, and paste the six lines it gives you.
# They look like this (fake values):
#   GITHUB_APP_ID=123456
#   GITHUB_APP_SLUG=pitch-in-example-org
#   GITHUB_APP_CLIENT_ID=Iv23liFakeClientId00
#   GITHUB_APP_CLIENT_SECRET=0000000000000000000000000000000000000000
#   GITHUB_APP_WEBHOOK_SECRET=fake-webhook-secret
#   GITHUB_APP_PRIVATE_KEY=LS0tLS1CRUdJTi...(base64 of the .pem file)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=
